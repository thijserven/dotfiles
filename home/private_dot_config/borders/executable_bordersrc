#!/usr/bin/env bash

# JankyBorders — Catppuccin Macchiato
# Colors use AARRGGBB format.

options=(
  style=round
  width=8.0
  hidpi=on

  # Active window — mauve
  active_color=0xffc6a0f6

  # Inactive windows — surface0
  inactive_color=0xff24273a

  # Subtle transparent background — base
  background_color=0x2024273a

  # Excluded applications
  blacklist="Vicinae"
)

borders "${options[@]}"
