{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 2
  },
  "plugins": [
    {
      "package": "@vheins/opencode-9router@latest",
      "options": {
        "baseURL": "{env:NINE_ROUTER_HOST}",
        "apiKey": "{env:NINE_ROUTER_API_KEY}",
        "cache": true,
        "discoveryTimeout": 30000
      }
    }
  ]
}
